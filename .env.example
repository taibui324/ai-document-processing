# Synthetic local demo only. Replace secrets before exposing the service.
APP_ENV=local
AI_MODE=mock
API_SECRET=local-synthetic-api-secret
VENDOR_SECRET=local-synthetic-vendor-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=medicon
DB_PASSWORD=local-demo-db
DB_NAME=medicon
REDIS_URL=redis://127.0.0.1:6379
# Real mode requires a key/model, official Gemini origin, and HTTPS vendor.
# Selected model: gemini-2.5-flash; live access needs separate verification.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Native-process default is localhost; Compose supplies its internal mock hostname.
# VENDOR_BASE_URL=http://127.0.0.1:4000
